# PostgreSQL database. Change password locally; don't commit credentials.
GODGRAM_DB=Host=localhost;Port=5432;Database=godgram;Username=godgram;Password=CHANGE_ME
# Only the operator-configured account can receive owner role.
GODGRAM_OWNER_PHONE=998901234567
# Show codes in terminal for LOCAL DEVELOPMENT ONLY. No SMS is sent.
GODGRAM_DEV_CODES=1
ASPNETCORE_URLS=http://127.0.0.1:8080
